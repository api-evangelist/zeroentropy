                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"input_type\": \"<string>\",\n  \"input\": \"<string>\",\n  \"dimensions\": \"<integer>\",\n  \"encoding_format\": \"float\",\n  \"latency\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
