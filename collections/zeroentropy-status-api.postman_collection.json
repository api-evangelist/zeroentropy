          "name": "Get Status",
          "request": {
            "name": "Get Status",
            "description": {
              "content": "Gets the current indexing status across all documents.\n\nIf a collection name is passed in, it will get the indexing status of only the documents within that collection. Otherwise, it will show the cumulative status across all of your collections.\n\nA `404 Not Found` status code will be returned, if a collection name was provided, but it does not exist.",
              "type": "text/plain"
            },
